# Application
APP_NAME=EmployeeMint
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://hrms:hrms@localhost:5432/hrms
DATABASE_URL_SYNC=postgresql+psycopg://hrms:hrms@localhost:5432/hrms

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hrms-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Platform
PLATFORM_ADMIN_EMAIL=admin@employeemint.local
PLATFORM_ADMIN_PASSWORD=changeme

# Tenant routing
TENANT_ROUTING_MODE=path

# Frontend
VITE_API_BASE_URL=http://localhost:8000
